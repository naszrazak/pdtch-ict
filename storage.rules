rules_version = '2';

// Gambar label no. siri / pelekat harta modal. Hanya pengguna berdaftar dan aktif dalam Firestore.
service firebase.storage {
  match /b/{bucket}/o {
    function berdaftar() {
      return request.auth != null
        && request.auth.token.email is string
        && firestore.get(/databases/(default)/documents/pengguna/$(request.auth.token.email.lower())).data.aktif == true;
    }
    function peranan() {
      return firestore.get(/databases/(default)/documents/pengguna/$(request.auth.token.email.lower())).data.peranan;
    }

    match /aset/{asetId}/{fail} {
      allow read: if berdaftar();
      allow create: if berdaftar()
        && peranan() in ['admin', 'juruteknik']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if berdaftar() && peranan() == 'admin';
      allow update: if false;
    }
  }
}
